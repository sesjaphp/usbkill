[Unit]
Description=Record usbkill watchdog failure
Documentation=https://github.com/sesjaphp/usbkill

[Service]
Type=oneshot
ExecStart=/usr/bin/logger -p authpriv.alert -t usbkill "usbkill watchdog failed; inspect journalctl -u usbkill.service -b immediately"
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
