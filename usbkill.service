[Unit]
Description=USB physical-presence shutdown watchdog
Documentation=https://github.com/sesjaphp/usbkill
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service
Conflicts=shutdown.target reboot.target halt.target
Before=shutdown.target reboot.target halt.target
ConditionPathExists=/run/usbkill/armed
OnFailure=usbkill-failure.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/usbkill daemon
Restart=no
KillSignal=SIGTERM
RuntimeDirectory=usbkill
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
