[Unit]
Description=USB physical-presence shutdown watchdog
Documentation=https://github.com/sesjaphp/usbkill
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service
Conflicts=shutdown.target reboot.target halt.target
Before=shutdown.target reboot.target halt.target
ConditionPathExists=/run/usbkill/armed
OnFailure=usbkill-failure.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/usbkill daemon
Restart=no
KillSignal=SIGTERM
RuntimeDirectory=usbkill
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
UMask=0077
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
